# ---------------------------------------------------------------------------
# Smart Queue backend configuration. Copy to backend/.env and fill in.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Supabase PostgreSQL — use the *Session pooler* connection string
# (Project Settings → Database → Connection string → Session pooler, port 5432).
# Render has no IPv6 egress, so the direct db.<ref>.supabase.co host will not work there.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only secret. Used for staff account creation and menu image uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still signs JWTs with the legacy shared secret (HS256).
# Leave empty to verify tokens with the project's asymmetric JWKS keys.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=menu-images

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend — used to build the digital menu link sent on WhatsApp
PUBLIC_APP_URL=http://localhost:5173

# Redis (Upstash in production: rediss://default:PASSWORD@HOST:6379?ssl_cert_reqs=required)
REDIS_URL=redis://localhost:6379/0

# Meta WhatsApp Business Cloud API
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_MAX_ATTEMPTS=5

# Default region used when a phone number is typed without a country code
DEFAULT_PHONE_REGION=IN
