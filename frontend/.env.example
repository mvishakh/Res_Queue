# Smart Queue frontend. Copy to .env.local. Only PUBLIC values belong here —
# never put the Supabase service-role key or any database credential in the frontend.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The public anon / publishable key (safe for browsers; protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=

# FastAPI backend base URL (no trailing slash)
VITE_API_URL=http://localhost:8000
